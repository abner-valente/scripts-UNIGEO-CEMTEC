# Copie este arquivo para ".env" e preencha só o que a máquina usa.
# O arquivo .env NÃO deve ser commitado: ele guarda o token e as senhas.

# Token de acesso à API do INMET (apitempo.inmet.gov.br). Todas as máquinas precisam dele, por ora.
TOKEN_INMET=seu_token_aqui

# De onde o painel e os produtos leem os dados: "apis" (o padrão, direto do INMET e do Open-Meteo).
# As outras fontes ("banco" e a API de leitura) chegam nas próximas versões.
# FONTE_DADOS=apis

# =====================================================
# BANCO (PostgreSQL da UNIGEO)
# =====================================================
# Cada conexão vai entre aspas, no formato de palavras-chave do PostgreSQL. Uma senha com @, : ou #
# entra como está, sem codificar. Deixe de fora as linhas que a máquina não usa.

# Os coletores gravam com o usuário que grava. Só no servidor (a VM).
# BANCO_GRAVACAO="host=servidor port=5432 dbname=banco user=usuario_que_grava password=senha"

# O painel do servidor (e, depois, a API de leitura) leem com o usuário que só lê. Só no servidor.
# BANCO_LEITURA="host=servidor port=5432 dbname=banco user=usuario_que_le password=senha"

# Os testes do banco usam o usuário que grava e o schema climageo_teste, onde criam e apagam
# tabelas à vontade. Só na máquina de quem programa. Sem esta linha, esses testes são pulados.
# BANCO_TESTE="host=servidor port=5432 dbname=banco user=usuario_que_grava password=senha"

# O schema das tabelas. Só mude se o banco tiver outro nome para ele.
# BANCO_SCHEMA=climageo
